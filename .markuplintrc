{
  "extends": [
    "markuplint:recommended"
  ],
  "nodeRules": [
    {
      "selector": "html",
      "rules": {
        "no-unknown-attr": {
          "options": {
            "allowAttrs": ["prefix"]
          }
        }
      }
    },
    {
      "selector": "audio",
      "rules": {
        "require-element": false
      }
    },
    {
      "selector": "#MathJax-script",
      "rules": {
        "require-attr": ["async"]
      }
    },
    {
      "selector": "td",
      "rules": {
        "a11y/no-merge-cells": false
      }
    }
  ]
}
